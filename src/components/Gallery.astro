---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface GalleryItem {
  image: ImageMetadata;
  alt: string;
  caption?: string;
}

interface Props {
  items: GalleryItem[];
}

const { items } = Astro.props;
---

{items.length > 0 && (
  <div class="my-6 grid grid-cols-1 gap-4 sm:grid-cols-2">
    {items.map((item) => (
      <figure>
        <Image
          src={item.image}
          alt={item.alt}
          class="w-full rounded-lg"
          widths={[400, 800]}
          sizes="(max-width: 640px) 100vw, 50vw"
        />
        {item.caption && (
          <figcaption class="mt-1.5 text-sm text-slate-500 dark:text-slate-400">{item.caption}</figcaption>
        )}
      </figure>
    ))}
  </div>
)}
