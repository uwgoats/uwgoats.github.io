---
import ThemeToggle from './ThemeToggle.astro';

const nav = [
  { href: '/', label: 'Home' },
  { href: '/logs', label: 'Design Log' },
  { href: '/references', label: 'References' },
  { href: '/about', label: 'About' },
];

const subsystems = [
  { href: '/subsystems/mechanical', label: 'Mechanical' },
  { href: '/subsystems/electrical', label: 'Electrical' },
  { href: '/subsystems/controls', label: 'Controls' },
  { href: '/subsystems/software', label: 'Software' },
];

const base = import.meta.env.BASE_URL;
const current = Astro.url.pathname;
const isSubsystemsActive = current.startsWith(`${base}subsystems`);
---

<header class="sticky top-0 z-50 border-b border-slate-200 bg-white/80 backdrop-blur dark:border-neutral-800 dark:bg-neutral-950/80">
  <div class="mx-auto flex max-w-4xl items-center justify-between px-4 py-4 sm:px-6">
    <a href={base} class="y2k-chrome text-lg font-bold uppercase tracking-wide">
      Design Log
    </a>

    <div class="flex items-center gap-2">
      <nav class="hidden items-center gap-1 sm:flex">
        {nav.map((item) => {
          const href = item.href === '/' ? base : `${base}${item.href.slice(1)}`;
          const isActive = current === href || (item.href !== '/' && current.startsWith(href));
          return (
            <a
              href={href}
              class:list={[
                'rounded-md px-3 py-2 text-sm font-medium transition',
                isActive
                  ? 'y2k-pill-active'
                  : 'text-slate-600 hover:text-slate-900 dark:text-slate-400 dark:hover:text-white',
              ]}
            >
              {item.label}
            </a>
          );
        })}

        <div class="relative" id="subsystems-dropdown">
          <button
            type="button"
            id="subsystems-button"
            aria-haspopup="true"
            aria-expanded="false"
            class:list={[
              'flex items-center gap-1 rounded-md px-3 py-2 text-sm font-medium transition',
              isSubsystemsActive
                ? 'y2k-pill-active'
                : 'text-slate-600 hover:text-slate-900 dark:text-slate-400 dark:hover:text-white',
            ]}
          >
            Subsystems
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="h-3.5 w-3.5">
              <path d="M6 9l6 6 6-6"></path>
            </svg>
          </button>
          <div
            id="subsystems-menu"
            class="absolute right-0 z-50 mt-2 hidden w-44 flex-col overflow-hidden rounded-md border border-slate-200 bg-white shadow-lg dark:border-neutral-800 dark:bg-neutral-900"
          >
            {subsystems.map((item) => {
              const href = `${base}${item.href.slice(1)}`;
              return (
                <a
                  href={href}
                  class="px-3 py-2 text-sm font-medium text-slate-600 transition hover:bg-slate-100 hover:text-slate-900 dark:text-slate-400 dark:hover:bg-neutral-800 dark:hover:text-white"
                >
                  {item.label}
                </a>
              );
            })}
          </div>
        </div>
      </nav>

      <a
        href="https://github.com/uwgoats/uwgoats.github.io"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="View source on GitHub"
        class="inline-flex h-9 w-9 items-center justify-center rounded-full border border-slate-300 text-slate-700 transition hover:border-transparent hover:bg-slate-100 hover:text-slate-900 dark:border-neutral-700 dark:text-slate-200 dark:hover:bg-neutral-800 dark:hover:text-white"
      >
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="h-5 w-5">
          <path d="M12 .5C5.65.5.5 5.65.5 12a11.5 11.5 0 0 0 7.86 10.93c.58.1.79-.25.79-.56v-2.17c-3.2.7-3.87-1.36-3.87-1.36-.53-1.34-1.29-1.7-1.29-1.7-1.05-.72.08-.7.08-.7 1.17.08 1.78 1.2 1.78 1.2 1.03 1.77 2.7 1.26 3.36.96.1-.75.4-1.26.73-1.55-2.55-.29-5.24-1.28-5.24-5.69 0-1.26.45-2.29 1.19-3.09-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.18 1.18a11 11 0 0 1 5.8 0c2.2-1.49 3.17-1.18 3.17-1.18.63 1.59.24 2.76.12 3.05.74.8 1.18 1.83 1.18 3.09 0 4.42-2.69 5.4-5.25 5.68.42.36.78 1.08.78 2.17v3.22c0 .31.21.67.8.56A11.5 11.5 0 0 0 23.5 12C23.5 5.65 18.35.5 12 .5Z" />
        </svg>
      </a>

      <ThemeToggle />

      <button
        id="mobile-menu-button"
        type="button"
        aria-label="Toggle navigation menu"
        aria-expanded="false"
        class="inline-flex h-9 w-9 items-center justify-center rounded-md border border-slate-300 text-slate-700 sm:hidden dark:border-neutral-700 dark:text-slate-200"
      >
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="h-5 w-5">
          <path d="M3 6h18M3 12h18M3 18h18"></path>
        </svg>
      </button>
    </div>
  </div>

  <nav id="mobile-menu" class="hidden flex-col gap-1 border-t border-slate-200 px-4 py-3 sm:hidden dark:border-neutral-800">
    {nav.map((item) => {
      const href = item.href === '/' ? base : `${base}${item.href.slice(1)}`;
      const isActive = current === href || (item.href !== '/' && current.startsWith(href));
      return (
        <a
          href={href}
          class:list={[
            'rounded-md px-3 py-2 text-sm font-medium transition',
            isActive
              ? 'y2k-pill-active'
              : 'text-slate-600 hover:text-slate-900 dark:text-slate-400 dark:hover:text-white',
          ]}
        >
          {item.label}
        </a>
      );
    })}
    <p class="mt-2 px-3 text-xs font-semibold uppercase tracking-wide text-slate-400 dark:text-slate-500">Subsystems</p>
    {subsystems.map((item) => {
      const href = `${base}${item.href.slice(1)}`;
      const isActive = current === href;
      return (
        <a
          href={href}
          class:list={[
            'rounded-md px-3 py-2 text-sm font-medium transition',
            isActive
              ? 'y2k-pill-active'
              : 'text-slate-600 hover:text-slate-900 dark:text-slate-400 dark:hover:text-white',
          ]}
        >
          {item.label}
        </a>
      );
    })}
  </nav>
</header>

<script is:inline>
  const menuButton = document.getElementById('mobile-menu-button');
  const menu = document.getElementById('mobile-menu');
  menuButton?.addEventListener('click', () => {
    const isOpen = menu?.classList.toggle('flex');
    menu?.classList.toggle('hidden');
    menuButton.setAttribute('aria-expanded', String(Boolean(isOpen)));
  });

  const subsystemsButton = document.getElementById('subsystems-button');
  const subsystemsMenu = document.getElementById('subsystems-menu');
  const subsystemsDropdown = document.getElementById('subsystems-dropdown');

  subsystemsButton?.addEventListener('click', (event) => {
    event.stopPropagation();
    const isOpen = subsystemsMenu?.classList.toggle('flex');
    subsystemsMenu?.classList.toggle('hidden');
    subsystemsButton.setAttribute('aria-expanded', String(Boolean(isOpen)));
  });

  document.addEventListener('click', (event) => {
    if (!subsystemsDropdown?.contains(event.target)) {
      subsystemsMenu?.classList.add('hidden');
      subsystemsMenu?.classList.remove('flex');
      subsystemsButton?.setAttribute('aria-expanded', 'false');
    }
  });
</script>
