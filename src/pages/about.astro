---
import Base from '../layouts/Base.astro';
---

<Base title="About | Design Log">
  <h1 class="y2k-heading text-4xl font-extrabold uppercase tracking-tight sm:text-5xl">About this project</h1>

  <section class="y2k-window mt-6 bg-slate-50 dark:bg-neutral-900">
    <div class="y2k-window-titlebar">
      <span class="y2k-window-dot"></span>
      <span class="y2k-window-dot"></span>
      <span class="y2k-window-dot"></span>
      <span class="y2k-window-label">about.txt</span>
    </div>
    <div class="y2k-window-body">
      <div class="prose-log">
        <p>
          This site documents the design and development process for my capstone
          project. Each entry in the <a href={`${import.meta.env.BASE_URL}logs`}>design log</a> captures
          a step in the process — research, prototypes, decisions, and the
          reasoning behind them.
        </p>
        <p>
          Replace this page with details about your project: the problem you're
          solving, your goals, your team, and links to relevant resources.
        </p>
      </div>
    </div>
  </section>
</Base>
