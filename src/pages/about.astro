---
import Base from '../layouts/Base.astro';
---

<Base title="About | Design Log">
  <h1 class="text-3xl font-bold tracking-tight text-slate-900 dark:text-white">About this project</h1>
  <div class="prose-log mt-6">
    <p>
      This site documents the design and development process for my capstone
      project. Each entry in the <a href={`${import.meta.env.BASE_URL}logs`}>design log</a>
      captures a step in the process — research, prototypes, decisions, and
      the reasoning behind them.
    </p>
    <p>
      Replace this page with details about your project: the problem you're
      solving, your goals, your team, and links to relevant resources.
    </p>
  </div>
</Base>
