---
import Base from '../../layouts/Base.astro';
import LogCard from '../../components/LogCard.astro';
import { getCollection } from 'astro:content';

const allLogs = await getCollection('logs', ({ data }) => !data.draft);
const sortedLogs = allLogs.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const allTags = [...new Set(sortedLogs.flatMap((entry) => entry.data.tags))].sort();
---

<Base title="All Entries | Design Log">
  <h1 class="text-3xl font-bold tracking-tight text-slate-900 dark:text-white">Design Log</h1>
  <p class="mt-3 max-w-2xl text-slate-600 dark:text-slate-400">
    Every entry, newest first. Filter by tag to focus on a specific area.
  </p>

  {allTags.length > 0 && (
    <div class="mt-6 flex flex-wrap gap-2" id="tag-filters">
      <button
        data-tag="all"
        class="tag-filter-btn rounded-full bg-teal-600 px-3 py-1.5 text-xs font-medium text-white"
      >
        All
      </button>
      {allTags.map((tag) => (
        <button
          data-tag={tag}
          class="tag-filter-btn rounded-full bg-slate-100 px-3 py-1.5 text-xs font-medium text-slate-600 transition hover:bg-slate-200 dark:bg-slate-800 dark:text-slate-300 dark:hover:bg-slate-700"
        >
          {tag}
        </button>
      ))}
    </div>
  )}

  <div class="mt-8 grid grid-cols-1 gap-5 sm:grid-cols-2" id="log-grid">
    {sortedLogs.map((entry) => (
      <div class="log-item" data-tags={entry.data.tags.join(',')}>
        <LogCard entry={entry} />
      </div>
    ))}
  </div>

  <p id="no-results" class="mt-8 hidden text-slate-500 dark:text-slate-400">
    No entries match this tag yet.
  </p>
</Base>

<script is:inline>
  const buttons = document.querySelectorAll('.tag-filter-btn');
  const items = document.querySelectorAll('.log-item');
  const noResults = document.getElementById('no-results');

  const activeClasses = ['bg-teal-600', 'text-white'];
  const inactiveClasses = ['bg-slate-100', 'text-slate-600', 'dark:bg-slate-800', 'dark:text-slate-300'];

  function setActive(button) {
    buttons.forEach((btn) => {
      btn.classList.remove(...activeClasses);
      btn.classList.add(...inactiveClasses);
    });
    button.classList.remove(...inactiveClasses);
    button.classList.add(...activeClasses);
  }

  buttons.forEach((button) => {
    button.addEventListener('click', () => {
      const tag = button.dataset.tag;
      setActive(button);

      let visibleCount = 0;
      items.forEach((item) => {
        const tags = item.dataset.tags?.split(',') ?? [];
        const show = tag === 'all' || tags.includes(tag);
        item.classList.toggle('hidden', !show);
        if (show) visibleCount++;
      });

      noResults?.classList.toggle('hidden', visibleCount !== 0);
    });
  });
</script>
