---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const subsystems = [
    { slug: 'mechanical', label: 'Mechanical' },
    { slug: 'electrical', label: 'Electrical' },
    { slug: 'controls', label: 'Controls' },
    { slug: 'software', label: 'Software' },
  ];

  return subsystems.map(({ slug, label }) => ({
    params: { subsystem: slug },
    props: { label },
  }));
}

const { subsystem } = Astro.params;
const { label } = Astro.props;

const allDecisions = await getCollection('decisions', ({ data }) => !data.draft && data.subsystem === subsystem);
const sortedDecisions = allDecisions.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const statusStyles: Record<string, string> = {
  final: 'text-teal-600 dark:text-teal-400',
  proposed: 'text-amber-600 dark:text-amber-400',
  superseded: 'text-slate-400 dark:text-slate-500 line-through',
};
---

<Base title={`${label} Subsystem | Design Log`}>
  <a href={`${import.meta.env.BASE_URL}subsystems`} class="text-sm text-teal-600 hover:underline dark:text-teal-400">
    &larr; All subsystems
  </a>
  <h1 class="y2k-heading mt-2 text-4xl font-extrabold uppercase tracking-tight sm:text-5xl">{label}</h1>
  <p class="mt-3 max-w-2xl text-slate-600 dark:text-slate-400">Finalized work decisions for the {label.toLowerCase()} subsystem.</p>

  {sortedDecisions.length === 0 ? (
    <p class="mt-8 text-slate-500 dark:text-slate-400">No decisions logged yet.</p>
  ) : (
    <div class="mt-8 flex flex-col gap-5">
      {sortedDecisions.map((entry) => {
        const { title, date, summary, status, tags } = entry.data;
        const formattedDate = date.toLocaleDateString('en-US', {
          year: 'numeric',
          month: 'long',
          day: 'numeric',
          timeZone: 'UTC',
        });
        return (
          <div class="y2k-card rounded-xl border border-slate-200 bg-white p-5 dark:border-neutral-800 dark:bg-neutral-900">
            <div class="mb-2 flex flex-wrap items-center gap-2 text-xs text-slate-500 dark:text-slate-400">
              <time datetime={date.toISOString()}>{formattedDate}</time>
              <span aria-hidden="true">&middot;</span>
              <span class:list={['font-medium uppercase', statusStyles[status]]}>{status}</span>
            </div>
            <h3 class="text-lg font-semibold text-slate-900 dark:text-white">{title}</h3>
            <p class="mt-2 text-sm text-slate-600 dark:text-slate-400">{summary}</p>
            {tags.length > 0 && (
              <div class="mt-4 flex flex-wrap gap-2">
                {tags.map((tag) => (
                  <span class="y2k-chip rounded-full bg-slate-100 px-2.5 py-1 text-xs font-medium text-slate-600 dark:bg-neutral-800 dark:text-slate-300">
                    {tag}
                  </span>
                ))}
              </div>
            )}
          </div>
        );
      })}
    </div>
  )}
</Base>
